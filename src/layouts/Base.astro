---
import "../styles/global.css";
import { profile } from "../data/site.js";

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..500;1,6..72,300..500&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: profile.name,
        jobTitle: profile.role,
        email: profile.email,
        url: Astro.site,
        sameAs: [profile.github, profile.linkedin],
      })}
    />
  </head>

  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">EMRE ÇANAKLI <span>/ Unity</span></a>
        <nav class="site-nav">
          <a href="/#work">Work</a>
          <a href="/#systems">Systems</a>
          <a class="nav-hide-sm" href={profile.github}>GitHub</a>
          <a class="nav-cv" href={profile.cv}>CV</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <p class="eyebrow" style="margin-bottom:0.6rem">Open to Senior Unity roles</p>
            <a class="footer-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
            <p class="lede" style="font-size:0.88rem;margin-top:0.6rem">{profile.availability}</p>
          </div>
          <div class="footer-links">
            <a href={profile.linkedin}>LinkedIn</a>
            <a href={profile.github}>GitHub</a>
            <a href={profile.cv}>CV (PDF)</a>
          </div>
        </div>
        <div class="colophon">
          <span>© {new Date().getFullYear()} {profile.name}</span>
          <span>Store artwork belongs to its respective publishers</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Reveal-on-scroll, deliberately not an IntersectionObserver.
      //
      // Content is visible by default and only elements that start below the
      // fold are ever hidden, so a script failure or a missed callback cannot
      // leave text unreadable. A plain scroll check also cannot skip an element
      // the way an observer does when an anchor jump moves it past the viewport
      // in a single frame.
      (() => {
        const els = [...document.querySelectorAll(".reveal")];
        if (!els.length) return;

        const trigger = () => window.innerHeight * 0.94;
        let pending = [];

        for (const el of els) {
          if (el.getBoundingClientRect().top > trigger()) {
            el.classList.add("pending");
            pending.push(el);
          }
        }

        let queued = false;
        const check = () => {
          queued = false;
          const line = trigger();
          pending = pending.filter((el) => {
            if (el.getBoundingClientRect().top > line) return true;
            el.classList.add("in");
            return false;
          });
          if (!pending.length) {
            removeEventListener("scroll", onScroll);
            removeEventListener("resize", onScroll);
          }
        };

        const onScroll = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(check);
        };

        addEventListener("scroll", onScroll, { passive: true });
        addEventListener("resize", onScroll);
        onScroll();
      })();
    </script>
  </body>
</html>
