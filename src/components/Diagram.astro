---
// Schematic diagrams for the case studies. Inline SVG, theme colours by CSS
// variable, no library. Each one shows the mechanism the section describes.
const { name } = Astro.props;
---

{
  name === "save" && (
    <figure class="diagram">
      <svg viewBox="0 0 760 320" role="img" aria-labelledby="d-save-t">
        <title id="d-save-t">
          Thirteen feature services inherit one generic save base, which serialises through shared
          settings to a local file and, past an integrity guard, to PlayFab.
        </title>

        <g class="d-stack">
          <rect x="8" y="46" width="150" height="42" rx="6" />
          <rect x="14" y="56" width="150" height="42" rx="6" />
          <rect x="20" y="66" width="150" height="42" rx="6" class="d-fill" />
          <text x="95" y="87" class="d-label" text-anchor="middle">13 save domains</text>
          <text x="95" y="128" class="d-sub" text-anchor="middle">Progression, Customization,</text>
          <text x="95" y="142" class="d-sub" text-anchor="middle">Achievements, LiveOps…</text>
        </g>

        <path d="M170 87 H208" class="d-arrow" />

        <rect x="210" y="44" width="190" height="86" rx="8" class="d-box d-accent" />
        <text x="305" y="72" class="d-label" text-anchor="middle">DataManagementService</text>
        <text x="305" y="90" class="d-label d-mono" text-anchor="middle">&lt;TData&gt;</text>
        <text x="305" y="114" class="d-sub" text-anchor="middle">load · migrate · debounce · dispose</text>

        <path d="M305 130 V160" class="d-arrow" />

        <rect x="212" y="162" width="186" height="42" rx="6" class="d-box" />
        <text x="305" y="180" class="d-label" text-anchor="middle">Shared serializer settings</text>
        <text x="305" y="196" class="d-sub" text-anchor="middle">one contract, both stores</text>

        <path d="M250 204 V238 H190 V262" class="d-arrow" />
        <path d="M360 204 V238 H470 V262" class="d-arrow" />

        <rect x="100" y="264" width="180" height="42" rx="6" class="d-box" />
        <text x="190" y="291" class="d-label" text-anchor="middle">Local file</text>

        <rect x="430" y="208" width="248" height="36" rx="6" class="d-box d-guard" />
        <text x="554" y="223" class="d-label" text-anchor="middle">Integrity guard</text>
        <text x="554" y="237" class="d-sub" text-anchor="middle">refuses an empty overwrite</text>

        <path d="M554 244 V252" class="d-arrow" />

        <rect x="430" y="254" width="248" height="36" rx="6" class="d-box d-guard" />
        <text x="554" y="269" class="d-label" text-anchor="middle">Version envelope</text>
        <text x="554" y="283" class="d-sub" text-anchor="middle">counter + writer identity, newer wins</text>

        <path d="M678 272 H700 V162 H600" class="d-arrow" />
        <rect x="420" y="140" width="180" height="40" rx="6" class="d-box d-fill" />
        <text x="510" y="157" class="d-label" text-anchor="middle">PlayFab batch write</text>
        <text x="510" y="172" class="d-sub d-mono" text-anchor="middle">9 keys + 1 envelope = 10 max</text>

        <text x="690" y="88" class="d-sub" text-anchor="middle">0.5s</text>
        <text x="690" y="103" class="d-sub" text-anchor="middle">debounce</text>
        <path d="M400 87 H660" class="d-arrow d-dash" />
      </svg>
    </figure>
  )
}

{
  name === "wardrobe" && (
    <figure class="diagram">
      <svg viewBox="0 0 760 300" role="img" aria-labelledby="d-ward-t">
        <title id="d-ward-t">
          A themed set sells as one real-money purchase, then dissolves into the player's normal
          owned-items list while a separate record remembers which sets were bought.
        </title>

        <rect x="16" y="26" width="150" height="46" rx="6" class="d-box" />
        <text x="91" y="45" class="d-label" text-anchor="middle">Shop banner</text>
        <text x="91" y="61" class="d-sub" text-anchor="middle">while the event runs</text>

        <path d="M166 49 H208" class="d-arrow" />
        <rect x="210" y="26" width="164" height="46" rx="6" class="d-box d-fill" />
        <text x="292" y="45" class="d-label" text-anchor="middle">Event popup</text>
        <text x="292" y="61" class="d-sub" text-anchor="middle">one card per set</text>

        <path d="M374 49 H416" class="d-arrow" />
        <rect x="418" y="26" width="164" height="46" rx="6" class="d-box d-accent" />
        <text x="500" y="45" class="d-label" text-anchor="middle">Real-money purchase</text>
        <text x="500" y="61" class="d-sub" text-anchor="middle">the set, not the pieces</text>

        <path d="M500 72 V104" class="d-arrow" />

        <rect x="300" y="106" width="400" height="48" rx="8" class="d-box" />
        <text x="500" y="126" class="d-label" text-anchor="middle">Pieces written into the normal owned-items list</text>
        <text x="500" y="143" class="d-sub" text-anchor="middle">a set piece then behaves like any other item</text>

        <rect x="46" y="106" width="228" height="48" rx="8" class="d-box d-guard" />
        <text x="160" y="126" class="d-label" text-anchor="middle">Separate record of sets bought</text>
        <text x="160" y="143" class="d-sub" text-anchor="middle">so the shop never sells one twice</text>
        <path d="M300 130 H276" class="d-arrow d-dash" />

        <path d="M500 154 V186" class="d-arrow" />
        <rect x="330" y="188" width="180" height="42" rx="6" class="d-box d-fill" />
        <text x="420" y="205" class="d-label" text-anchor="middle">Auto-equipped</text>
        <text x="420" y="221" class="d-sub" text-anchor="middle">the player sees what they paid for</text>

        <path d="M510 209 H558" class="d-arrow" />
        <rect x="560" y="188" width="180" height="42" rx="6" class="d-box" />
        <text x="650" y="205" class="d-label" text-anchor="middle">Mixed with anything</text>
        <text x="650" y="221" class="d-sub" text-anchor="middle">worn partially, own category</text>

        <line x1="16" y1="252" x2="744" y2="252" class="d-rule" />
        <text x="380" y="278" class="d-sub" text-anchor="middle">
          after the event ends the set stays purchasable; unowned pieces leave the normal grid so they do not look free
        </text>
      </svg>
    </figure>
  )
}

{
  name === "config" && (
    <figure class="diagram">
      <svg viewBox="0 0 760 300" role="img" aria-labelledby="d-cfg-t">
        <title id="d-cfg-t">
          One loader reads plain JSON from Title Data, merges the player's treatment variables on top
          field by field, falls back to hard-coded defaults on timeout, and reports the variant to
          Amplitude.
        </title>

        <rect x="16" y="28" width="176" height="56" rx="8" class="d-box" />
        <text x="104" y="52" class="d-label" text-anchor="middle">Feature asks for a key</text>
        <text x="104" y="70" class="d-sub" text-anchor="middle">one loader, thirteen configs</text>

        <path d="M192 56 H240" class="d-arrow" />

        <rect x="242" y="16" width="200" height="40" rx="6" class="d-box d-fill" />
        <text x="342" y="33" class="d-label" text-anchor="middle">Title Data</text>
        <text x="342" y="48" class="d-sub" text-anchor="middle">plain JSON, editable in dashboard</text>

        <rect x="242" y="62" width="200" height="40" rx="6" class="d-box d-accent" />
        <text x="342" y="79" class="d-label" text-anchor="middle">Treatment variables</text>
        <text x="342" y="94" class="d-sub" text-anchor="middle">this player's variant</text>

        <path d="M442 36 H482 V52" class="d-arrow" />
        <path d="M442 82 H482 V66" class="d-arrow" />

        <rect x="484" y="38" width="176" height="44" rx="8" class="d-box d-accent" />
        <text x="572" y="56" class="d-label" text-anchor="middle">Merge, field by field</text>
        <text x="572" y="72" class="d-sub" text-anchor="middle">variables win, no code change</text>

        <path d="M572 82 V116" class="d-arrow" />
        <rect x="484" y="118" width="176" height="36" rx="6" class="d-box" />
        <text x="572" y="141" class="d-label" text-anchor="middle">Config delivered</text>

        <rect x="16" y="118" width="176" height="56" rx="8" class="d-box d-guard" />
        <text x="104" y="142" class="d-label" text-anchor="middle">Hard-coded defaults</text>
        <text x="104" y="160" class="d-sub" text-anchor="middle">on 5s timeout, or a guest</text>
        <path d="M104 118 V90 H192 V56" class="d-arrow d-dash" />

        <line x1="16" y1="196" x2="744" y2="196" class="d-rule" />

        <rect x="242" y="218" width="418" height="56" rx="8" class="d-box d-fill" />
        <text x="451" y="242" class="d-label" text-anchor="middle">Amplitude: variant as a user property, per session</text>
        <text x="451" y="260" class="d-sub" text-anchor="middle">
          any existing event breaks down by experiment, no per-test engineering
        </text>
        <path d="M572 154 V218" class="d-arrow d-dash" />
      </svg>
    </figure>
  )
}

{
  name === "login" && (
    <figure class="diagram">
      <svg viewBox="0 0 760 300" role="img" aria-labelledby="d-login-t">
        <title id="d-login-t">
          The old flow copied the other account's data into the current one; the new flow records the
          switch on disk, resets local state and signs into the target through the backend's own door.
        </title>

        <text x="16" y="30" class="d-sub d-mono">BEFORE</text>
        <rect x="16" y="40" width="150" height="44" rx="6" class="d-box" />
        <text x="91" y="59" class="d-label" text-anchor="middle">Sign in, email B</text>
        <text x="91" y="75" class="d-sub" text-anchor="middle">on account A</text>

        <path d="M166 62 H214" class="d-arrow" />
        <rect x="216" y="40" width="186" height="44" rx="6" class="d-box" />
        <text x="309" y="59" class="d-label" text-anchor="middle">Log into B directly</text>
        <text x="309" y="75" class="d-sub" text-anchor="middle">backend never told</text>

        <path d="M402 62 H450" class="d-arrow" />
        <rect x="452" y="32" width="292" height="60" rx="6" class="d-box d-bad" />
        <text x="598" y="52" class="d-label" text-anchor="middle">Session = B, backend = A</text>
        <text x="598" y="70" class="d-sub" text-anchor="middle">store empty, gems unbuyable</text>
        <text x="598" y="85" class="d-sub" text-anchor="middle">so instead: copy B's data over A</text>

        <line x1="16" y1="112" x2="744" y2="112" class="d-rule" />

        <text x="16" y="142" class="d-sub d-mono">AFTER</text>
        <rect x="16" y="152" width="150" height="52" rx="6" class="d-box" />
        <text x="91" y="174" class="d-label" text-anchor="middle">Comparison screen</text>
        <text x="91" y="191" class="d-sub" text-anchor="middle">both accounts, real avatars</text>

        <path d="M166 178 H210" class="d-arrow" />
        <rect x="212" y="152" width="164" height="52" rx="6" class="d-box d-accent" />
        <text x="294" y="174" class="d-label" text-anchor="middle">Mark switch on disk</text>
        <text x="294" y="191" class="d-sub" text-anchor="middle">before anything else</text>

        <path d="M376 178 H420" class="d-arrow" />
        <rect x="422" y="152" width="150" height="52" rx="6" class="d-box" />
        <text x="497" y="174" class="d-label" text-anchor="middle">Reset local state</text>
        <text x="497" y="191" class="d-sub" text-anchor="middle">nothing copied</text>

        <path d="M572 178 H616" class="d-arrow" />
        <rect x="618" y="152" width="126" height="52" rx="6" class="d-box d-fill" />
        <text x="681" y="174" class="d-label" text-anchor="middle">Backend's own</text>
        <text x="681" y="191" class="d-label" text-anchor="middle">login door</text>

        <path d="M681 204 V232 H91 V254" class="d-arrow" />
        <rect x="16" y="256" width="240" height="34" rx="6" class="d-box d-fill" />
        <text x="136" y="278" class="d-label" text-anchor="middle">In-place restart, behind the loader</text>

        <text x="470" y="228" class="d-sub" text-anchor="middle">
          if the restart ever fails, the disk record makes the next launch finish the job
        </text>
      </svg>
    </figure>
  )
}

{
  name === "popup" && (
    <figure class="diagram">
      <svg viewBox="0 0 760 300" role="img" aria-labelledby="d-popup-t">
        <title id="d-popup-t">
          A session-start strategy is chosen from player age and session count, then each candidate
          passes a filter chain before it is ever constructed.
        </title>

        <rect x="16" y="24" width="186" height="62" rx="8" class="d-box" />
        <text x="109" y="48" class="d-label" text-anchor="middle">Session start</text>
        <text x="109" y="67" class="d-sub" text-anchor="middle">days installed · session count</text>

        <path d="M202 55 H250" class="d-arrow" />

        <rect x="252" y="16" width="246" height="78" rx="8" class="d-box d-accent" />
        <text x="375" y="40" class="d-label" text-anchor="middle">Strategy selection</text>
        <text x="375" y="59" class="d-sub" text-anchor="middle">day 0 first session → login bonus only</text>
        <text x="375" y="76" class="d-sub" text-anchor="middle">day 1+ → pass, bonus, sub, one offer</text>

        <path d="M498 55 H548" class="d-arrow" />
        <rect x="550" y="24" width="194" height="62" rx="8" class="d-box d-guard" />
        <text x="647" y="48" class="d-label" text-anchor="middle">Three hard guards</text>
        <text x="647" y="67" class="d-sub" text-anchor="middle">shown · auto-swipe · no matches</text>

        <path d="M375 94 V126" class="d-arrow" />

        <rect x="196" y="128" width="358" height="58" rx="8" class="d-box d-fill" />
        <text x="375" y="152" class="d-label" text-anchor="middle">Filter chain, before construction</text>
        <text x="375" y="171" class="d-sub" text-anchor="middle">A/B variant filter · flagged-account filter</text>

        <path d="M280 186 V216" class="d-arrow" />
        <path d="M470 186 V216" class="d-arrow d-dash" />

        <rect x="176" y="218" width="208" height="46" rx="6" class="d-box" />
        <text x="280" y="238" class="d-label" text-anchor="middle">Built and shown</text>
        <text x="280" y="255" class="d-sub" text-anchor="middle">data passed at creation</text>

        <rect x="398" y="218" width="208" height="46" rx="6" class="d-box" />
        <text x="502" y="238" class="d-label" text-anchor="middle">Suppressed</text>
        <text x="502" y="255" class="d-sub" text-anchor="middle">never constructed, costs nothing</text>

        <text x="375" y="288" class="d-sub" text-anchor="middle">
          same pattern drives shop banners and sidebar icons; ordering is inspector data
        </text>
      </svg>
    </figure>
  )
}

{
  name === "catalogs" && (
    <figure class="diagram">
      <svg viewBox="0 0 760 300" role="img" aria-labelledby="d-cat-t">
        <title id="d-cat-t">
          One boot catalog of 137 entries loads at startup; three larger domains load additively on
          their own triggers.
        </title>

        <rect x="20" y="26" width="170" height="62" rx="8" class="d-box d-accent" />
        <text x="105" y="50" class="d-label" text-anchor="middle">App start</text>
        <text x="105" y="70" class="d-sub" text-anchor="middle">Addressables.InitializeAsync</text>

        <path d="M190 57 H250" class="d-arrow" />

        <rect x="252" y="26" width="230" height="62" rx="8" class="d-box d-fill" />
        <text x="367" y="50" class="d-label" text-anchor="middle">Boot catalog</text>
        <text x="367" y="70" class="d-sub d-mono" text-anchor="middle">~137 entries · ~200 KB</text>

        <text x="612" y="52" class="d-sub" text-anchor="middle">UI · fonts · databases</text>
        <text x="612" y="68" class="d-sub" text-anchor="middle">core narrative runtime</text>

        <path d="M367 88 V116" class="d-arrow d-dash" />
        <text x="367" y="134" class="d-sub" text-anchor="middle">loaded additively, on trigger</text>

        <rect x="20" y="150" width="230" height="80" rx="8" class="d-box" />
        <text x="135" y="176" class="d-label" text-anchor="middle">Narrative content</text>
        <text x="135" y="195" class="d-sub d-mono" text-anchor="middle">~2,521 entries</text>
        <text x="135" y="216" class="d-sub" text-anchor="middle">first chat or date</text>

        <rect x="266" y="150" width="230" height="80" rx="8" class="d-box" />
        <text x="381" y="176" class="d-label" text-anchor="middle">Photos</text>
        <text x="381" y="195" class="d-sub d-mono" text-anchor="middle">~4,170 entries</text>
        <text x="381" y="216" class="d-sub" text-anchor="middle">album, profile, gallery</text>

        <rect x="512" y="150" width="228" height="80" rx="8" class="d-box" />
        <text x="626" y="176" class="d-label" text-anchor="middle">Auxiliary</text>
        <text x="626" y="195" class="d-sub d-mono" text-anchor="middle">~312 entries</text>
        <text x="626" y="216" class="d-sub" text-anchor="middle">background, after login</text>

        <path d="M135 250 H626" class="d-arrow d-dash" />
        <text x="380" y="277" class="d-sub" text-anchor="middle">
          delivered remotely over Unity CCD · updated without a store release
        </text>
      </svg>
    </figure>
  )
}

{
  name === "liveops" && (
    <figure class="diagram">
      <svg viewBox="0 0 760 300" role="img" aria-labelledby="d-lo-t">
        <title id="d-lo-t">
          Remote configuration feeds an event core, which drives two event shapes and offers popups to
          a priority queue rather than opening its own windows.
        </title>

        <rect x="20" y="24" width="180" height="56" rx="8" class="d-box" />
        <text x="110" y="47" class="d-label" text-anchor="middle">Remote config</text>
        <text x="110" y="65" class="d-sub" text-anchor="middle">windows, content, rewards</text>

        <rect x="20" y="100" width="180" height="56" rx="8" class="d-box" />
        <text x="110" y="123" class="d-label" text-anchor="middle">Seasonal packages</text>
        <text x="110" y="141" class="d-sub" text-anchor="middle">art, copy, configuration</text>

        <path d="M200 52 H262 V80" class="d-arrow" />
        <path d="M200 128 H262 V100" class="d-arrow" />

        <rect x="264" y="62" width="212" height="80" rx="8" class="d-box d-accent" />
        <text x="370" y="90" class="d-label" text-anchor="middle">Event core</text>
        <text x="370" y="110" class="d-sub" text-anchor="middle">database · activity windows</text>
        <text x="370" y="126" class="d-sub" text-anchor="middle">progress · transactions</text>

        <path d="M370 142 V170" class="d-arrow" />
        <rect x="196" y="172" width="160" height="46" rx="6" class="d-box d-fill" />
        <text x="276" y="192" class="d-label" text-anchor="middle">Special sales</text>
        <text x="276" y="208" class="d-sub" text-anchor="middle">windowed offer</text>

        <rect x="384" y="172" width="160" height="46" rx="6" class="d-box d-fill" />
        <text x="464" y="192" class="d-label" text-anchor="middle">Endless offers</text>
        <text x="464" y="208" class="d-sub" text-anchor="middle">stepped claim</text>

        <path d="M476 102 H560" class="d-arrow" />
        <rect x="562" y="62" width="178" height="80" rx="8" class="d-box d-guard" />
        <text x="651" y="90" class="d-label" text-anchor="middle">Popup queue</text>
        <text x="651" y="110" class="d-sub" text-anchor="middle">priority scheduling</text>
        <text x="651" y="126" class="d-sub" text-anchor="middle">one window at a time</text>

        <path d="M370 218 V250" class="d-arrow d-dash" />
        <text x="370" y="270" class="d-sub" text-anchor="middle">
          progress persisted as a normal save domain, inside the integrity guard
        </text>
      </svg>
    </figure>
  )
}

{
  name === "aichat" && (
    <figure class="diagram">
      <svg viewBox="0 0 760 300" role="img" aria-labelledby="d-ai-t">
        <title id="d-ai-t">
          A player message is gated by subscription, assembled with character settings and conversation
          memory, routed through a gateway, and streamed back with cancellation and a report path.
        </title>

        <rect x="16" y="112" width="132" height="56" rx="8" class="d-box" />
        <text x="82" y="136" class="d-label" text-anchor="middle">Player message</text>
        <text x="82" y="154" class="d-sub" text-anchor="middle">chat view</text>

        <path d="M148 140 H190" class="d-arrow" />
        <rect x="192" y="112" width="120" height="56" rx="8" class="d-box d-guard" />
        <text x="252" y="136" class="d-label" text-anchor="middle">Paywall gate</text>
        <text x="252" y="154" class="d-sub" text-anchor="middle">subscription</text>

        <path d="M312 140 H354" class="d-arrow" />

        <rect x="356" y="96" width="176" height="88" rx="8" class="d-box d-accent" />
        <text x="444" y="122" class="d-label" text-anchor="middle">Context assembly</text>
        <text x="444" y="142" class="d-sub" text-anchor="middle">character personality</text>
        <text x="444" y="158" class="d-sub" text-anchor="middle">conversation memory</text>
        <text x="444" y="174" class="d-sub" text-anchor="middle">within a token budget</text>

        <rect x="356" y="24" width="176" height="44" rx="6" class="d-box d-fill" />
        <text x="444" y="42" class="d-label" text-anchor="middle">Authored settings</text>
        <text x="444" y="58" class="d-sub" text-anchor="middle">per character, no build</text>
        <path d="M444 68 V94" class="d-arrow d-dash" />

        <path d="M532 140 H578" class="d-arrow" />
        <rect x="580" y="112" width="164" height="56" rx="8" class="d-box" />
        <text x="662" y="136" class="d-label" text-anchor="middle">Model gateway</text>
        <text x="662" y="154" class="d-sub" text-anchor="middle">routing · per-model cost</text>

        <path d="M662 168 V206 H82 V232" class="d-arrow" />
        <text x="372" y="200" class="d-sub" text-anchor="middle">streamed tokens · cancellable mid-response</text>

        <rect x="16" y="234" width="132" height="46" rx="6" class="d-box d-fill" />
        <text x="82" y="254" class="d-label" text-anchor="middle">Chat bubble</text>
        <text x="82" y="270" class="d-sub" text-anchor="middle">token by token</text>

        <path d="M148 257 H202" class="d-arrow d-dash" />
        <rect x="204" y="234" width="170" height="46" rx="6" class="d-box d-guard" />
        <text x="289" y="254" class="d-label" text-anchor="middle">Report flow</text>
